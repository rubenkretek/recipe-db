# Supabase — Project Settings > API
#
# Both of these are NEXT_PUBLIC_, which means Next.js inlines them into the
# client bundle at BUILD time, not at runtime. When deploying to Coolify they
# must be supplied as build arguments. Setting them as runtime-only environment
# variables produces a build with `undefined` baked in, which fails at the first
# Supabase call with a confusing error.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable (anon) key. Safe to expose: it is subject to Row Level
# Security. This is the only Supabase key the application ever uses.
#
# The service role key is deliberately absent and must never be added. It
# bypasses RLS entirely. Anything that cannot be expressed under RLS is a
# `security definer` Postgres function instead. See CLAUDE.md "Architecture".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Anthropic — for importing a recipe from a file.
#
# Deliberately NOT prefixed NEXT_PUBLIC_. This one is a secret: it is read only
# inside a server action, never reaches the browser, and prefixing it would
# inline it into the client bundle for anyone to read.
#
# Unlike the two Supabase variables above, this is a RUNTIME environment
# variable in Coolify, not a build argument — the server reads it when a file is
# imported, not when the image is built. Without it the import button reports
# that importing is not configured; nothing else in the app is affected.
ANTHROPIC_API_KEY=your-anthropic-api-key
