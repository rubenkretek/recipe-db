# Supabase — Project Settings > API
#
# Both of these are NEXT_PUBLIC_, which means Next.js inlines them into the
# client bundle at BUILD time, not at runtime. When deploying to Coolify they
# must be supplied as build arguments. Setting them as runtime-only environment
# variables produces a build with `undefined` baked in, which fails at the first
# Supabase call with a confusing error.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable (anon) key. Safe to expose: it is subject to Row Level
# Security. This is the only Supabase key the application ever uses.
#
# The service role key is deliberately absent and must never be added. It
# bypasses RLS entirely. Anything that cannot be expressed under RLS is a
# `security definer` Postgres function instead. See CLAUDE.md "Architecture".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
